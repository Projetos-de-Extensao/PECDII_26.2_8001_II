@startuml seq_01_autenticacao_cadastro
autonumber
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
title Diagrama de Sequencia - Autenticacao e Cadastro (UC01 a UC04)

actor "Usuario / Visitante" as User
actor "Administrador" as Admin
boundary "API de Acesso\n(/api/token/, /api/cadastro/,\n/api/senha/)" as Boundary
control "Controladores de Autenticacao\ne Cadastros (pessoas.autenticacao /\npessoas.cadastros)" as Control
entity "auth.User /\nFuncionario / Atleta" as Entity
entity "Responsavel /\nConsentimentoLGPD" as LGPD
participant "Servico de E-mail" as Mail

== UC01 - Autenticar-se (login por token JWT) ==
User -> Boundary : POST /api/token/ (email, password)
activate Boundary
Boundary -> Control : TokenPorEmailSerializer.validate(email, password)
activate Control
Control -> Entity : buscar login (username__iexact=email) e autenticar
activate Entity
Entity --> Control : usuario (is_active) ou nenhum
deactivate Entity
alt Credenciais validas e conta ativa
Control --> Boundary : access (30 min) e refresh (7 dias)
Boundary --> User : 200 OK com os tokens
else Senha errada, e-mail desconhecido ou conta inativa (A3)
Control --> Boundary : falha de autenticacao (mesma resposta nos tres casos)
Boundary --> User : 401 "E-mail ou senha incorretos"
end
deactivate Control
deactivate Boundary

opt Token de acesso expirado (A4)
User -> Boundary : POST /api/token/refresh/ (refresh)
activate Boundary
alt Refresh valido
Boundary --> User : 200 OK com novo access
else Refresh expirado ou invalido
Boundary --> User : 401 (volta ao login)
end
deactivate Boundary
end

== UC02 - Cadastrar-se (Atleta ou Responsavel, com consentimento LGPD) ==
User -> Boundary : POST /api/cadastro/ (tipo, nome, email, senha,\ndata_nascimento, aceitou_termos)
activate Boundary
Boundary -> Control : CadastroSerializer (valida dados e forca da senha)
activate Control
alt Senha fraca ou atleta sem data de nascimento
Control --> Boundary : erro de validacao
Boundary --> User : 400 Bad Request
else Nao aceitou termos LGPD (E1)
Control --> Boundary : ValidationError("Obrigatorio aceitar os termos")
Boundary --> User : 400 Bad Request
else E-mail ja cadastrado (A1)
Control -> Entity : filter(username__iexact=email).exists()
Entity --> Control : True
Control --> Boundary : ValidationError("E-mail ja cadastrado")
Boundary --> User : 400 Bad Request
else Atleta menor de 18 anos (A2: dependente e cadastrado pelo\nresponsavel logado em /api/atletas/)
Control --> Boundary : ValidationError("Atleta menor de idade exige responsavel")
Boundary --> User : 400 Bad Request (transacao desfeita)
else Dados validos (transacao atomica)
Control -> Entity : User.objects.create_user(username=email, ...)
activate Entity
Entity --> Control : usuario
deactivate Entity
Control -> LGPD : ConsentimentoLGPD.objects.create(usuario, versao_termos)
activate LGPD
LGPD --> Control : consentimento
deactivate LGPD
alt tipo = atleta
Control -> Entity : Atleta.objects.create(usuario, data_nascimento)
else tipo = responsavel
Control -> LGPD : Responsavel.objects.create(usuario, cpf, telefone)
end
Control --> Boundary : cadastro criado
Boundary --> User : 201 Created (id, tipo, nome_completo, email)
end
deactivate Control
deactivate Boundary

== UC03 - Recuperar Senha (link de uso unico, valido por 1 hora) ==
User -> Boundary : POST /api/senha/recuperar/ (email)
activate Boundary
Boundary -> Control : SolicitarRecuperacaoView (limite de 5 pedidos por hora)
activate Control
Control -> Entity : buscar usuario ativo por e-mail
Entity --> Control : usuario ou nenhum
opt Usuario encontrado e ativo
Control -> Control : gerar uid e token (default_token_generator)
Control -> Mail : enviar link com uid e token
Mail --> User : E-mail com link de redefinicao
end
Control --> Boundary : mesma mensagem, exista o e-mail ou nao (A5)
Boundary --> User : 200 OK "Se o e-mail estiver cadastrado, enviaremos um link"
deactivate Control
deactivate Boundary

User -> Boundary : POST /api/senha/redefinir/ (uid, token, senha)
activate Boundary
Boundary -> Control : RedefinirSenhaView
activate Control
Control -> Entity : buscar usuario pelo uid e conferir o token
alt Link invalido, expirado ou ja usado (E2)
Control --> Boundary : ValidationError("Link invalido ou expirado")
Boundary --> User : 400 Bad Request
else Token valido
Control -> Control : validar forca da senha
Control -> Entity : set_password(senha) (invalida o link)
Control --> Boundary : senha alterada
Boundary --> User : 200 OK
end
deactivate Control
deactivate Boundary

== UC04 - Cadastrar Profissional ou Recepcao ==
Admin -> Boundary : Informar e-mail, nome, matricula,\ndata_admissao e papeis (Profissional/Recepcao)
activate Boundary
Boundary -> Control : cadastrar_funcionario(email, nome, matricula, data_admissao)
activate Control
Control -> Entity : filter(username__iexact=email).exists()
alt E-mail ja cadastrado (UC04 A1)
Entity --> Control : True
Control --> Boundary : ValidationError("E-mail ja cadastrado")
Boundary --> Admin : Exibir erro de duplicidade
else E-mail disponivel
Entity --> Control : False
Control -> Entity : User.objects.create_user(...)
Control -> Entity : Funcionario.objects.create(usuario, matricula, data_admissao)
Control -> Entity : Profissional/Recepcao.objects.create(funcionario)
Entity --> Control : funcionario e papeis vinculados
Control --> Boundary : Cadastro concluido
Boundary --> Admin : Exibir confirmacao
end
deactivate Control
deactivate Boundary
@enduml
